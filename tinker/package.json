{
  "name": "tinker",
  "version": "1.0.0",
  "description": "Tinker - Project-embedded learning notebook",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite -c vite.renderer.config.ts",
    "build": "tsc && vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build -c vite.renderer.config.ts",
    "design:lint": "node ./node_modules/@google/design.md/dist/index.js lint DESIGN.md",
    "design:export:tailwind": "node ./node_modules/@google/design.md/dist/index.js export --format tailwind DESIGN.md",
    "design:export:dtcg": "node ./node_modules/@google/design.md/dist/index.js export --format dtcg DESIGN.md",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "npm run rebuild:native",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:electron-smoke": "node scripts/electron-smoke.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.60.0",
    "@types/three": "^0.184.0",
    "3d-force-graph": "^1.80.0",
    "better-sqlite3": "^12.0.0",
    "date-fns": "^4.0.0",
    "drizzle-orm": "^0.40.1",
    "force-graph": "^1.51.4",
    "framer-motion": "^11.18.2",
    "konva": "^9.0.0",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.9",
    "puppeteer": "^24.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-joyride": "^3.1.0",
    "react-konva": "^19.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.184.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@google/design.md": "^0.1.1",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "react-window": "^2.2.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.0"
  }
}
